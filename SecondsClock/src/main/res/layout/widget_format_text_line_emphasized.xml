<?xml version="1.0" encoding="utf-8"?>
<TextClock xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_format_text_block_clock"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1.6"
    android:autoSizeMinTextSize="1px"
    android:autoSizeMaxTextSize="3000px"
    android:autoSizeStepGranularity="1px"
    android:autoSizeTextType="uniform"
    android:gravity="top|center_horizontal"
    android:includeFontPadding="false"
    android:singleLine="true" />
