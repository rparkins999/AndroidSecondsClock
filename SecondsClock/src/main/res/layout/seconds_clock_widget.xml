<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/appwidget_root"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <uk.co.yahoo.p1rpp.secondsclock.CheckboxTextClock
        android:id="@+id/appwidget_textclock"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center" />

    <include
        layout="@layout/analog_clock_widget"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.5"
        android:visibility="gone" />

    <uk.co.yahoo.p1rpp.secondsclock.CheckboxTextClock
        android:id="@+id/appwidget_analog_dateclock"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:gravity="center"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/appwidget_format_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="top"
        android:orientation="vertical"
        android:visibility="gone" />
</LinearLayout>
